# Jarvis Configuration

# Audio settings
# Interrupting Jarvis by speaking. Needs headphones or hardware echo
# cancellation: on open speakers Jarvis hears itself and cuts itself off.
BARGE_IN=false
BARGE_IN_MIN_SPEECH_MS=200
# Hands-free activation: wait for "hey Jarvis" instead of transcribing the
# whole room. Needs: pip install "jarvis-assistant[wakeword]" and a one-time
# model download (see the README). Off by default.
WAKE_WORD=false
# A pretrained openWakeWord model: hey_jarvis, alexa, hey_mycroft,
# hey_rhasspy - or the path to one you trained yourself.
WAKE_WORD_MODEL=hey_jarvis
# Raise it if the room sets it off, lower it if it misses you.
WAKE_WORD_THRESHOLD=0.5
# Seconds kept after the phrase, so "hey Jarvis quelle heure est-il" works in
# one breath instead of having to be said twice.
WAKE_WORD_TAIL=0.5
# After an answer, listen this long without needing the phrase again.
# 0 requires it every turn.
WAKE_WORD_FOLLOW_UP=8
SAMPLE_RATE=16000
CHANNELS=1
# Microphone: a name, an index, or empty for the system default.
# python -c "import sounddevice; print(sounddevice.query_devices())"
AUDIO_INPUT_DEVICE=
CHUNK_SIZE=320

# STT settings
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Language code, or "auto" to detect it from the speech.
WHISPER_LANGUAGE=fr

# LLM settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# A second Ollama to fall back to when the first cannot be reached: typically
# a self-hosted box on the LAN holding the big model, with a small model here
# for when the LAN is not there. Leave the host empty for a single provider.
# Jarvis returns to the preferred one as soon as it answers again.
OLLAMA_FALLBACK_HOST=
OLLAMA_FALLBACK_MODEL=
# A small fallback model picks badly from a large toolbox. 0 means no cap.
OLLAMA_FALLBACK_MAX_TOOLS=8
# Three or more providers, or per-provider context windows, go in this file
# instead; when it exists it replaces the three settings above.
# See llm_providers.example.json.
LLM_PROVIDERS_PATH=llm_providers.json
# A provider probe runs before the first word is spoken, so it has to be
# quick. Raise it if a remote host is slow to answer.
LLM_PROBE_TIMEOUT=5
# How long to stay on a fallback before looking for the preferred provider
# again, in seconds.
LLM_PROVIDER_RECHECK_SECONDS=60
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
# Ollama defaults its context to a few thousand tokens whatever the model's
# native size, and tool schemas are re-sent every turn. Raising this costs RAM.
LLM_NUM_CTX=8192
# Above this many tools, only the ones relevant to the turn are offered.
TOOL_SELECTION_THRESHOLD=20
TOOL_SELECTION_TOP_K=15

# TTS settings
PIPER_MODEL=en_US-lessac-medium
PIPER_SPEAKER_ID=0

# System settings
MAX_CONVERSATION_HISTORY=10
ALLOWED_DIRECTORIES=~/Documents,~/Downloads,/tmp
DENIED_PATTERNS=.ssh,.aws,.gnupg,.kube,.docker,.env,.env.*,*_history,*.pem,*.key,id_rsa*,credentials,.netrc,.npmrc,.pypirc
# Launchers only: a whitelisted CLI tool bypasses the file sandbox entirely.
COMMAND_WHITELIST=code,firefox,nautilus,gedit,xdg-open
GUI_APPLICATIONS=code,firefox,nautilus,gedit,xdg-open

# Web access
ALLOW_PRIVATE_NETWORK_FETCH=false
MAX_FETCH_BYTES=2000000
FETCH_TIMEOUT=10

# Document search (RAG). Build the index with: jarvis-index ~/Documents
# Embeddings come from Ollama, not sentence-transformers: no torch, no extra
# Python dependency, and a self-hosted provider computes them too.
#   ollama pull nomic-embed-text
RAG_EMBED_MODEL=nomic-embed-text
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_BATCH_SIZE=16
RAG_TOP_K=5
# Similarity below which a passage is not returned. Nearest-k always returns
# something, so without a floor a question your notes say nothing about comes
# back with the five least-irrelevant passages. The right value depends on the
# embedding model, so it is off by default: ask about something you know is
# not in your notes and look at the similarities printed in the answer.
RAG_MIN_SIMILARITY=0
# Only text is indexed; PDFs would mean a new dependency.
RAG_EXTENSIONS=.md,.txt,.rst,.org,.markdown,.text
RAG_MAX_FILE_BYTES=2000000

# MCP servers (see mcp_servers.example.json)
MCP_CONFIG_PATH=mcp_servers.json
MCP_CONNECT_TIMEOUT=15
MCP_CALL_TIMEOUT=60

# Reminders. "Remind me to call the plumber tomorrow at nine."
# They survive a restart, and anything that came due while Jarvis was off is
# delivered - and labelled late - the next time it starts.
REMINDERS=true
# How often the voice loop looks for one that has come due while it was
# waiting to be spoken to.
REMINDER_POLL_SECONDS=20

# Persistent state
DATA_DIR=~/.local/share/jarvis
# Conversations are written to disk in the clear, on this machine.
CONVERSATION_HISTORY=true

# Logging
LOG_LEVEL=INFO
